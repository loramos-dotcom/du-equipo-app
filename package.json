{
  "name": "du-equipo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "scripts": {
    "dev": "node --experimental-strip-types server/local.ts",
    "build": "tsc --noEmit && vite build && node scripts/build.mjs",
    "build:team": "tsc --noEmit && vite build",
    "test": "node --experimental-strip-types --test --test-concurrency=1 tests/domain.test.ts tests/api.test.ts tests/audit.test.ts tests/home.test.ts tests/usability.test.ts tests/deletion.test.ts tests/updates.test.ts tests/management.test.ts tests/management-postgres.test.ts tests/project-context.test.ts tests/meetings-complete.test.ts tests/daily-jobs.test.ts tests/structure-complete.test.ts tests/relational.test.ts tests/backups.test.ts tests/portfolio-access.test.ts tests/calendar.test.ts tests/work-links.test.ts tests/task-form.test.ts tests/education-security.test.ts tests/map-security.test.ts tests/private-data-check.test.ts",
    "validate": "node scripts/validate-artifact.mjs",
    "test:worker": "node --test tests/worker.test.mjs",
    "test:auth": "node --experimental-strip-types --test tests/team.test.ts tests/auth.test.ts tests/postgres.test.ts",
    "start:team": "node --experimental-strip-types server/production.ts",
    "bootstrap:team": "node --experimental-strip-types scripts/bootstrap-team.ts",
    "prepare:team": "node --experimental-strip-types scripts/prepare-team-install.ts",
    "test:install": "node --experimental-strip-types --test tests/install.test.ts",
    "styles:management": "node scripts/management-styles.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "@tanstack/react-query": "5.101.4",
    "drizzle-orm": "0.45.4",
    "leaflet": "1.9.4",
    "lucide-react": "1.59.0",
    "postcss": "8.5.25",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
